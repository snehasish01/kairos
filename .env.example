# Copy to .env.local and fill in. Never commit real values.

# Supabase (server-side API routes use the service role; RLS should deny anon everything)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (server-side only)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Prolific (research path only)
NEXT_PUBLIC_PROLIFIC_COMPLETION_CODE=

# Demo mode (no data saved). Demo is disabled when DEMO_TOKEN_SECRET is unset.
# Generate with: openssl rand -hex 32
DEMO_TOKEN_SECRET=
# "true" lets the demo call the Anthropic API (rate-limited); otherwise canned content.
DEMO_LLM_ENABLED=
DEMO_MAX_LLM_CALLS_PER_SESSION=
DEMO_MAX_LLM_CALLS_PER_IP_PER_HOUR=
DEMO_MAX_LLM_CALLS_PER_DAY=
